.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.swp
*.swo
*.env
.env.*
!.env.example
.vscode/
.idea/
*.iml

# ===========================================
# Node.js / Next.js (frontend/)
# ===========================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.production.local
frontend/.env.development.local
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===========================================
# Java / Spring Boot (backend/)
# ===========================================
backend/target/
backend/.mvn/
backend/mvnw
backend/mvnw.cmd
backend/*.iml
backend/*.log
*.class
*.jar
*.war
*.ear

# IntelliJ IDEA files
backend/.idea/
backend/.classpath
backend/.project
backend/.settings/

# ===========================================
# Python / FastAPI (ai/)
# ===========================================
ai/__pycache__/
ai/*.py[cod]
ai/.Python
ai/env/
ai/venv/
ai/.venv/
ai/pip-log.txt
ai/pyvenv.cfg

# ===========================================
# Go / Rust (cli/)
# ===========================================
cli/bin/
cli/pkg/
cli/target/
cli/Cargo.lock

# ===========================================
# Terraform / Infra
# ===========================================
infra/.terraform/
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/crash.log
infra/.terraform.lock.hcl

# ===========================================
# Docker
# ===========================================
docker-compose.override.yml
docker-compose.local.yml
*.dockerfile
.docker/

# ===========================================
# Logs / Misc
# ===========================================
logs/
*.log
*.bak
*.swp

